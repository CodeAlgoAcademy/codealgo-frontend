# Build-time config for the production image. Copy to .env.production.
#
#   cp .env.production.example .env.production
#
# .env.production is gitignored. CI writes it from GitHub Actions *variables*
# before `docker build` - see .github/workflows/deploy-cloudflare.yml.
#
# Everything here is compiled into the client bundle by `next build`, so all
# three values are readable by anyone with devtools. That is why they are
# variables and not secrets, and why setting them as Worker secrets at runtime
# would do nothing at all - the strings are already baked into the JavaScript.
#
# Runtime config that is NOT public (there is currently one: URL_GAME) goes in
# `vars` in deploy/cloudflare/wrangler.jsonc instead.

# The Django API. This is the Cloudflare Worker after cutover, and it is the
# one value that must change when prod-api stops pointing at Beanstalk.
NEXT_PUBLIC_API_URL=https://prod-api.codealgoacademy.com

# Stripe publishable key. Public by design. pk_live_... in production.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Collector for the admin analytics Worker (deploy/analytics). Leave empty and
# the tracker in utils/siteTracker.ts does nothing.
NEXT_PUBLIC_ANALYTICS_URL=https://e.codealgoacademy.com

